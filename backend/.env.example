APP_NAME=Enterprise RAG Agent
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Placeholder only. Keep real credentials and private endpoints in untracked backend/.env.
DASHSCOPE_API_KEY=
MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v1
MILVUS_URI=http://127.0.0.1:39530
MILVUS_COLLECTION=enterprise_rag
MILVUS_DIMENSION=1536
POSTGRES_DSN=postgresql+psycopg://rag:CHANGE_ME_DB_PASSWORD@127.0.0.1:35432/rag
REDIS_URL=redis://127.0.0.1:36379/0
STORAGE_ROOT=storage
MAX_UPLOAD_SIZE_MB=20

# Optional OCR; keep disabled until your own credentials are configured.
OCR_ENABLED=false
OCR_CLIENT_ID=
OCR_CLIENT_SECRET=
